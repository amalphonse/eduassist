# EduAssist Environment Configuration
# Copy this file to .env and fill in your values

# Your API key for the LLM (required)
OPENAI_API_KEY=paste-your-mai-key-here

# LLM proxy endpoint (leave as-is for MAI Practice)
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1

# Who the system acts as (one of: student.john, student.jane, teacher.smith, parent.doe, admin.principal)
SCHOOL_USER=student.john

# Secret for web access (generate with: openssl rand -hex 24)
# REQUIRED when running with --host 0.0.0.0 (Docker, cloud deployments)
CHAT_SECRET=

# Optional: Disable classification and tracing
MAI_CLASSIFY=0
MAI_TRACE=0
